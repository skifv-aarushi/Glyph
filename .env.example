# ===================================================
# Glyph Environment Configuration
# ===================================================

# Frontend Configuration (apps/web)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_SERVER_URL=ws://localhost:8080

# Backend Server Configuration (apps/server)
PORT=8080
NODE_ENV=development

# Upstash Redis Configuration (Distributed Pub/Sub & Mutex Locks)
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_ENDPOINT:6379
# Or Upstash REST if using http-client
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase S3-Compatible Persistence (Cold Document Storage & Hydration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=ephemeral-sessions
EPHEMERAL_GC_TIMEOUT_MS=300000
# Supabase S3 Endpoint credentials (if using AWS S3 Client)
SUPABASE_S3_ENDPOINT=https://your-project.storage.supabase.co/s3
SUPABASE_S3_ACCESS_KEY_ID=your-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=your-secret-access-key
SUPABASE_S3_REGION=us-east-1

# GitHub OAuth & REST API v3 Configuration
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
GITHUB_AUTH_TOKEN=ghp_optionalPersonalAccessTokenOrFallback
JWT_SECRET=super-secret-jwt-signing-key-glyph-2026
CLIENT_ORIGIN=http://localhost:3000

